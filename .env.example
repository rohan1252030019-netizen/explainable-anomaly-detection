# Backend / API configuration.
#
# Every value has a local-safe default in backend/config.py, so the project runs
# with no .env at all. Copy this file to .env only if you need to override
# something. .env is gitignored — never commit it.

# ── Server ─────────────────────────────────────────────────────────────────────
# Bound to localhost by default. Change to 0.0.0.0 only if you understand that
# this exposes an unauthenticated API to your network.
XAUD_HOST=127.0.0.1
XAUD_PORT=8000
XAUD_RELOAD=true

# ── CORS ───────────────────────────────────────────────────────────────────────
# Comma-separated allow-list. Wildcards are not accepted: combined with
# credentialed requests they would let any site read detection results from
# your local backend.
XAUD_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ── Upload guard rails ─────────────────────────────────────────────────────────
# Checked before the file is parsed. 25 MB / 200k rows comfortably covers
# tabular data while keeping a hostile upload from exhausting memory.
XAUD_MAX_UPLOAD_BYTES=26214400
XAUD_MAX_ROWS=200000

# ── Explainer budgets ──────────────────────────────────────────────────────────
# The model-agnostic SHAP explainer's cost grows with background size, so this
# is capped rather than left to consume whatever is available.
XAUD_SHAP_MAX_BACKGROUND=100
XAUD_MAX_EXPLANATIONS=200

# ── Frontend (Next.js) ─────────────────────────────────────────────────────────
# Read by frontend/src/lib/api.ts. Must match the backend host and port above.
NEXT_PUBLIC_API_URL=http://localhost:8000